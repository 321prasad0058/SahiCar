{
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "cleanUrls": true,
    "redirects": [
      {
        "source": "/li",
        "destination": "/?utm_source=linkedin&utm_medium=social&utm_campaign=company_page&utm_content=website",
        "type": 302
      },
      {
        "source": "/ig",
        "destination": "/?utm_source=instagram&utm_medium=social&utm_campaign=profile&utm_content=bio_link",
        "type": 302
      },
      {
        "source": "/igs",
        "destination": "/?utm_source=instagram&utm_medium=social&utm_campaign=story&utm_content=story_link",
        "type": 302
      },
      {
        "source": "/yt",
        "destination": "/?utm_source=youtube&utm_medium=social&utm_campaign=channel&utm_content=channel_link",
        "type": 302
      },
      {
        "source": "/ytv",
        "destination": "/?utm_source=youtube&utm_medium=social&utm_campaign=video&utm_content=description_link",
        "type": 302
      }
    ],
    "rewrites": [{ "source": "**", "destination": "/index.html" }],
    "headers": [
      { "source": "/", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "**/*.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/assets/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
      { "source": "**/*.@(jpg|png|svg|webp)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] },
      {
        "source": "**",
        "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
        ]
      }
    ]
  },
  "firestore": {
    "database": "(default)",
    "location": "asia-south1",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "auth": { "port": 9099 },
    "firestore": { "port": 8180 },
    "hosting": { "port": 5002 },
    "ui": { "enabled": false },
    "singleProjectMode": true
  }
}
