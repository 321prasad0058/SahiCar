# Firebase web app config (Firebase console → Project settings → Your apps → Web). Free Spark plan is enough.
# Without these the app still works fully; sign-in is hidden and your garage is kept in this browser.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=your-project
# VITE_FIREBASE_APP_ID=
# Google Analytics (Firebase console → Project settings → Integrations → Google Analytics)
# VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Local development against the Firebase emulators (put these in .env.development.local)
# VITE_FIREBASE_EMULATORS=1
# VITE_FIREBASE_PROJECT_ID=demo-sahicar
