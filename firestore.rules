rules_version = '2';

// SahiCar keeps very little about a person: their SahiFit answers and the cars they saved.
// Every document lives under the owner's uid and only that signed-in user can read or write it.
// Anonymous feedback can be written but never read back from the app.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function owner(userId) { return signedIn() && request.auth.uid == userId; }
    function small() { return request.resource.size() <= 40; }

    match /users/{userId} {
      allow read, delete: if owner(userId);
      allow create, update: if owner(userId) && small()
        && request.resource.data.keys().hasOnly(['name', 'email', 'photo', 'answers', 'updatedAt', 'createdAt'])
        && (!('answers' in request.resource.data) || request.resource.data.answers is map);

      // saved cars: one document per car id
      match /garage/{carId} {
        allow read, delete: if owner(userId);
        allow create, update: if owner(userId) && carId.size() <= 64
          && request.resource.data.keys().hasOnly(['carId', 'score', 'note', 'savedAt'])
          && request.resource.data.carId == carId;
      }
    }

    // feedback: anyone may send one short, well-formed note; nobody can read it from the app
    match /feedback/{id} {
      allow create: if request.resource.data.keys().hasOnly(['rating', 'topic', 'text', 'page', 'car', 'ctx', 'at'])
        && request.resource.data.text is string && request.resource.data.text.size() <= 1000
        && (request.resource.data.rating == null || request.resource.data.rating in ['yes', 'partly', 'no'])
        && (request.resource.data.topic == null || request.resource.data.topic in ['pick', 'data', 'bug', 'idea'])
        && (request.resource.data.rating != null || request.resource.data.text.size() > 0)
        && request.resource.data.page is string && request.resource.data.page.size() <= 120
        && (request.resource.data.car == null || (request.resource.data.car is string && request.resource.data.car.size() <= 64))
        && request.resource.data.ctx is map && request.resource.data.ctx.size() <= 12
        && request.resource.data.at == request.time;
    }

    // push alerts: a browser can add, update or remove its own subscription (the id is a SHA-256 of its push
    // address, so it can't be guessed); nobody can read them from the app. The sender reads them with admin access.
    match /push/{id} {
      allow create, update: if id.size() == 64
        && request.resource.data.keys().hasOnly(['sub', 'cars', 'topics', 'platform', 'at'])
        && request.resource.data.sub is map && request.resource.data.sub.keys().hasOnly(['endpoint', 'keys'])
        && request.resource.data.sub.endpoint is string && request.resource.data.sub.endpoint.size() <= 800
        && request.resource.data.sub.endpoint.matches('https://.*')
        && request.resource.data.sub['keys'] is map && request.resource.data.sub['keys'].keys().hasOnly(['p256dh', 'auth'])
        && request.resource.data.cars is list && request.resource.data.cars.size() <= 50
        && request.resource.data.topics is list && request.resource.data.topics.size() <= 5
        && request.resource.data.platform in ['ios', 'android', 'desktop']
        && request.resource.data.at == request.time;
      allow delete: if id.size() == 64;
    }

    // nothing else is readable or writable
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
